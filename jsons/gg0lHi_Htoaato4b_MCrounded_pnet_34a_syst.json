      "COLOR": 1,
      "TYPE": "SIGNAL",
      "TITLE": "H to aa to 4b, bm_{a} = XX (GeV)",
      "LOC": "path/FILE:HIST"
    }
  },
  "REGIONS": {
    "Pass": {
      "PROCESSES": [
        "SIGNAME"
      ],
      "BINNING": "default"
    },
    "Fail": {
      "PROCESSES": [
        "SIGNAME"
      ],
      "BINNING": "default"
    }
  },
  "GLOBAL": {
    "FILE": "$process.root"
  },
  "BINNING": {
    "default": {
      "X": {
        "NAME": "mH",
        "TITLE": "m_{H} (GeV)",
        "MIN": 60,
        "MAX": 200,
        "NBINS": 14,
        "SIGSTART": 110,
        "SIGEND": 140
      },
      "Y": {
        "NAME": "mA",
        "TITLE": "m_{a} (GeV)",
        "MIN": 10,
        "MAX": 66,
        "NBINS": 14
      }
    }
  },
  "SYSTEMATICS": {
    "pdf_99": {
      "ALIAS": "pdf_99",
