{
  "NAME": "gg0lHi_Htoaato4b",
  "PROCESSES": {
    "data_obs": {
      "SYSTEMATICS": [],
      "SCALE": 1.0,
      "COLOR": 1,
      "TYPE": "DATA",
      "ALIAS": "gg0lHi_MCrounded_Run2_pnet_34a",
      "TITLE": "Data",
      "LOC": "path/FILE:HIST"
    },
    "SIGNAME": {
      "SYSTEMATICS": [
        "pdf_99","ps_fsr","ps_isr","QCDscale_fac","QCDscale_ren","CMS_btag_fixedWP_comb_bc_correlated","CMS_eff_fj_LundPlan_reweighting"
      ],
